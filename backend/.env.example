# Server
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/outreach_auth

# JWT — generate strong random secrets for real environments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
# AES-256 key used to encrypt Gmail OAuth tokens at rest — generate the same way as the JWT secrets above.
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-strong-random-secret

# Google OAuth (consent screen)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-strong-random-secret
FRONTEND_URL=http://localhost:3000
