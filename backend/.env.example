# Server
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ai-outreach

# Auth
JWT_ACCESS_SECRET=replace-with-a-random-32+-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-random-32+-char-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Gmail OAuth token encryption (at-rest encryption for stored access/refresh tokens)
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32+-char-key

# Google OAuth (Gmail connection flow)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-random-32+-char-secret

# AWS — leave the two keys blank in any environment with an IAM role
# (ECS/EC2/Lambda); the SDK's default credential chain picks it up.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS — names are used by `npm run sqs:setup` to create the queues; URLs are
# printed by that script and must be pasted back in here for the API/worker.
SQS_EMAIL_QUEUE_NAME=outreach-email-send
SQS_EMAIL_DLQ_NAME=outreach-email-send-dlq
SQS_EMAIL_QUEUE_URL=
SQS_EMAIL_DLQ_URL=
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SQS_MESSAGE_RETENTION_SECONDS=345600
SQS_DLQ_MESSAGE_RETENTION_SECONDS=1209600
SQS_WAIT_TIME_SECONDS=20

# Email worker (src/worker/index.js)
WORKER_CONCURRENCY=5
WORKER_RATE_LIMIT_PER_SECOND=5
WORKER_SHUTDOWN_TIMEOUT_MS=30000
